NODE_ENV=development
# Render (and other hosts) inject PORT at runtime; leave it unset locally.
API_PORT=6001
# The API binds to 0.0.0.0 so containers and Render health checks can reach it.
HOST=0.0.0.0
DATABASE_URL=postgresql://warewise:warewise_local_only@localhost:5432/warewise
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
